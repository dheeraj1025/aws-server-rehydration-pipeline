variable "aws_region" {
  type        = string
  description = "Target AWS deployment region"
  default     = "us-east-1"
}

variable "environment" {
  type        = string
  description = "Target environment stage"
  default     = "production"
}

variable "vpc_cidr" {
  type        = string
  description = "CIDR block for the VPC"
  default     = "10.0.0.0/16"
}

variable "ami_id" {
  type        = string
  description = "Golden AMI ID generated by Packer"
}

variable "instance_type" {
  type        = string
  description = "EC2 instance sizing"
  default     = "t3.medium"
}

variable "asg_min_size" {
  type        = number
  description = "Minimum nodes in ASG"
  default     = 2
}

variable "asg_max_size" {
  type        = number
  description = "Maximum nodes in ASG"
  default     = 4
}

variable "asg_desired_capacity" {
  type        = number
  description = "Steady-state nodes in ASG"
  default     = 2
}
